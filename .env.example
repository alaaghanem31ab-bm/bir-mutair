# Environment variables example for bir-mutair

# Public (client) keys - required for browser/client usage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (do NOT commit to repo) - use in server environments / CI
# SUPABASE_SERVICE_ROLE_KEY=

# Other typical Next.js vars
NEXT_PUBLIC_APP_NAME=نظام إدارة البئر

